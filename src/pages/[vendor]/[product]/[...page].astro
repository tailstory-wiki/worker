---
import NotFound from "@/components/NotFound.astro";
import Subnav from "@/components/Subnav.astro";
import TocRail from "@/components/TocRail.astro";
import Layout from "@/layouts/Layout.astro";
import {
  fetchLinks,
  fetchPagePartial,
  fetchRegistry,
  fetchRootToc,
  isHubPagePartial,
  relativeSlug,
  resolveToc,
  tocEntryUrl,
} from "@/lib/docs";
import { env } from "@/lib/env";

const {
  vendor: vendorSlug,
  product: productSlug,
  page: pageParam,
} = Astro.params;
const vendor = vendorSlug ?? "";
const product = productSlug ?? "";
const page = pageParam && pageParam.length > 0 ? pageParam : "index";

const [partial, registry, toc, rootToc, links] = await Promise.all([
  fetchPagePartial(env.DOCS, vendor, product, page),
  fetchRegistry(env.REGISTRY),
  resolveToc(env.DOCS, vendor, product, page),
  fetchRootToc(env.DOCS, vendor, product),
  fetchLinks(env.DOCS, vendor, product),
]);

const vendorEntry = registry?.vendors.find(
  (vendorRecord) => vendorRecord.slug === vendor,
);
const productEntry = vendorEntry?.products.find(
  (productRecord) => productRecord.slug === product,
);
const vendorName = vendorEntry?.name ?? vendor;
const productName = productEntry?.name ?? product;

const breadcrumbs = [
  { label: vendorName, href: `/${vendor}` },
  { label: productName, href: `/${vendor}/${product}` },
];

// Section tabs: the curated `tabs` list from the product-root toc.json,
// rendered in the authored order. No tabs key means no tabs. A tab is
// active when the current page is the entry itself or lives underneath it.
const tabLeaves = Array.isArray(rootToc?.tabs) ? rootToc.tabs : [];
const tabs = tabLeaves.map((tabLeaf) => ({
  label: tabLeaf.title,
  href: tocEntryUrl(vendor, product, "", tabLeaf.page),
  active: page === tabLeaf.page || page.startsWith(`${tabLeaf.page}/`),
}));

// Hub pages (tsy.topic: hub-page) render without the TOC rail.
const hideTocRail = partial !== null && isHubPagePartial(partial);

if (partial === null) {
  Astro.response.status = 404;
}
---

{
  partial !== null ? (
    <Layout title={`${productName} — Tailstory wiki`}>
      <Subnav
        slot="subnav"
        breadcrumbs={breadcrumbs}
        tabs={tabs}
        links={links?.links ?? []}
      />
      <div class="page">
        {toc && !hideTocRail && (
          <TocRail
            toc={toc.toc}
            tocDir={toc.tocDir}
            vendor={vendor}
            product={product}
            currentPageSlug={relativeSlug(page, toc.tocDir)}
          />
        )}
        <article set:html={partial} />
      </div>
    </Layout>
  ) : (
    <NotFound message={`No doc found at ${vendor}/${product}/${page}.`} />
  )
}
